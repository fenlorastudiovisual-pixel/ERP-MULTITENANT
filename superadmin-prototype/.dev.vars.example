# Copiar a .dev.vars para probar el Worker en local (npm run preview).
# .dev.vars está excluido de Git. En producción usa secrets de Cloudflare.
DATABASE_URL=postgresql://neondb_owner:TU_PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_APP_URL=postgresql://erp_app:TU_PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
CF_ACCESS_TEAM_DOMAIN=https://tu-equipo.cloudflareaccess.com
CF_ACCESS_AUD=aud-tag-de-la-aplicacion
SUPERADMIN_KEY=cambia-esta-frase-secreta-larga
