# Connection string de Neon (Dashboard > tu proyecto > Connection string > pooled).
# Sin esta variable la app sigue funcionando con localStorage.
DATABASE_URL=

# Clave del Super Admin para los endpoints /api/state. Obligatoria en producción.
SUPERADMIN_KEY=cambia-esta-clave

# La necesita el navegador para enviar la clave al endpoint. Sustituir por auth real antes de producción.
NEXT_PUBLIC_SUPERADMIN_KEY=cambia-esta-clave
