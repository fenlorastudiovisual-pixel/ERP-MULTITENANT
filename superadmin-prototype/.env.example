# Connection string administrativa de Neon (Dashboard > tu proyecto > Connection string > pooled).
# Sin esta variable la app usa localStorage.
DATABASE_URL=

# Connection string que usa la app: mismo host, pero con el rol sin BYPASSRLS.
# Se genera con: npm run db:role
DATABASE_APP_URL=

# Modo de acceso (Cloudflare Access). Ambos valores son necesarios.
# Se obtienen en Cloudflare Zero Trust > Access > Applications > tu app > Additional settings.
CF_ACCESS_TEAM_DOMAIN=https://tu-equipo.cloudflareaccess.com
CF_ACCESS_AUD=aud-tag-de-la-aplicacion

# AUD de la aplicación Access que protege solo /negocio (panel del negocio).
CF_ACCESS_TENANT_AUD=aud-tag-de-la-aplicacion-del-negocio

# Secreto del servidor usado por el modo de respaldo con contraseña.
SUPERADMIN_KEY=cambia-esta-frase-secreta-larga

# Para crear el primer administrador (no se sube a Git):
# ADMIN_EMAIL=admin@tudominio.com ADMIN_PASSWORD=clave-de-al-menos-12-caracteres npm run db:admin
