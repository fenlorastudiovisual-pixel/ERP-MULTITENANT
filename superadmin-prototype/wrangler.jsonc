{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "erp-multitenant",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "hyperdrive": [
    {
      "binding": "SAMJURO_HYPERDRIVE",
      "id": "60ae12b8243146dd972a903b6c3bd6b3",
      "localConnectionString": "postgresql://erp_writer:__LOCAL_PLACEHOLDER__@127.0.0.1:5432/postgres"
    }
  ]
}
